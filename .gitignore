# .gitignore for Crime Scene Reconstruction System

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Data directories
**/data/uploads/
**/data/outputs/
**/data/temp/
**/temp/

# Model cache
.cache/
models/

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
**/.env
*.env.*

# Reports
*.pdf
*.json
*.wav

# 3D files
*.ply
*.obj

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Keep directory structure
!data/.gitkeep
!data/uploads/.gitkeep
!data/outputs/.gitkeep
